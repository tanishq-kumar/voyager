{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyager-ogm.org/schemas/corpus-scenario/v1.json",
  "title": "VoyagerCorpusScenarioV1",
  "description": "Schema for Query Spec conformance corpus scenario metadata (scenario.json).",
  "type": "object",
  "required": [
    "id",
    "pack",
    "description",
    "source",
    "params",
    "fixture",
    "rows",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Unique scenario identifier matching '<pack>/<scenario>'.",
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "pack": {
      "description": "Pack folder name (e.g. 'p0-match-return').",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "description": "Short human-readable summary of the scenario.",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "description": "Origin of the scenario (e.g. openCypher TCK feature and scenario name).",
      "type": "object",
      "required": ["kind", "feature", "scenario"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["opencypher-tck", "postgresql-regress", "voyager"]
        },
        "feature": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        }
      }
    },
    "params": {
      "description": "Query parameters mapping name to literal value.",
      "type": "object"
    },
    "fixture": {
      "description": "Base name of an engine-neutral fixture under spec/corpus/fixtures/<name>.json, or null only when a scenario intentionally runs on an empty graph.",
      "type": ["string", "null"]
    },
    "rows": {
      "description": "Expected row ordering semantics ('ordered' or 'unordered').",
      "type": "string",
      "enum": ["ordered", "unordered"]
    },
    "targets": {
      "description": "Compilation target dialects and their support status.",
      "type": "object",
      "required": ["cypher", "age", "gql", "sqlpgq"],
      "additionalProperties": false,
      "properties": {
        "cypher": { "$ref": "#/$defs/Target" },
        "age": { "$ref": "#/$defs/Target" },
        "gql": { "$ref": "#/$defs/Target" },
        "sqlpgq": { "$ref": "#/$defs/Target" }
      }
    },
    "reference_cypher": {
      "description": "Optional corrected openCypher statement used by the row recorder when targets.cypher.status is not 'supported'.",
      "type": "object",
      "required": ["statement", "reason"],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["reference_cypher"]
      },
      "then": {
        "properties": {
          "targets": {
            "properties": {
              "cypher": {
                "properties": {
                  "status": {
                    "enum": ["known-diff", "unsupported"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Target": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["supported", "unsupported", "known-diff"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["unsupported", "known-diff"] }
            }
          },
          "then": {
            "required": ["reason"]
          }
        }
      ]
    }
  }
}
