{
  "description": "max_hops null means exactly min_hops.",
  "spec": {
    "spec_version": 1,
    "matches": [
      {
        "paths": [
          [
            [
              "node",
              "p",
              [
                "Person"
              ]
            ],
            [
              "edge",
              "outgoing",
              [
                "KNOWS"
              ],
              "r",
              2,
              null
            ],
            [
              "node",
              "f",
              [
                "Person"
              ]
            ]
          ]
        ]
      }
    ],
    "projections": [
      [
        "field",
        "p",
        "name",
        null
      ]
    ]
  },
  "expected": {
    "cypher": {
      "statement": "MATCH (p:Person)-[r:KNOWS*2..2]->(f:Person) RETURN p.name",
      "parameters": {}
    },
    "age": {
      "statement": "SELECT * FROM cypher('age_graph', $$ MATCH (p:Person)-[r:KNOWS*2..2]->(f:Person) RETURN p.name $$) AS (\"name\" agtype)",
      "parameters": {}
    },
    "iso_gql": {
      "statement": "MATCH (p:Person)-[r:KNOWS]->{2,2}(f:Person) RETURN p.name",
      "parameters": {}
    },
    "sql_pgq": {
      "statement": "SELECT * FROM GRAPH_TABLE (graph_table MATCH (p IS \"Person\") -[r IS \"KNOWS\"]->{2,2} (f IS \"Person\") COLUMNS (p.name))",
      "parameters": {}
    },
    "duck_pgq": {
      "statement": "SELECT * FROM GRAPH_TABLE (graph_table MATCH (p IS \"Person\") -[r IS \"KNOWS\"]->{2,2} (f IS \"Person\") COLUMNS (p.name))",
      "parameters": {}
    }
  }
}
