{
  "description": "A WITH pipeline with distinct, order_by, skip and limit.",
  "spec": {
    "spec_version": 1,
    "matches": [
      {
        "paths": [
          [
            [
              "node",
              "p",
              [
                "Person"
              ]
            ]
          ]
        ]
      }
    ],
    "with_clauses": [
      {
        "projections": [
          [
            "field",
            "p",
            "name",
            "n"
          ]
        ],
        "distinct": true,
        "order_by": [
          [
            [
              "ident",
              "n"
            ],
            true
          ]
        ],
        "skip": 0,
        "limit": 5
      }
    ],
    "projections": [
      [
        "expr",
        [
          "ident",
          "n"
        ],
        null
      ]
    ]
  },
