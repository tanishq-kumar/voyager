{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyager-ogm.org/schemas/query-spec/v1.json",
  "title": "VoyagerQuerySpecV1",
  "description": "Voyager OGM Cross-Language Query Specification Interchange Protocol v1 ABI Contract. JSON null at an optional key or position means the same as omitting it. Only the document root requires spec_version; nested specs (matches, with_clauses, subqueries, object-wrapped expressions) may omit it, and if present it must be 1.",
  "allOf": [{ "$ref": "#/$defs/QuerySpec" }],
  "required": ["spec_version"],
  "$defs": {
    "QuerySpec": {
      "type": "object",
      "properties": {
        "spec_version": {
          "description": "Major specification protocol version. Required at the document root; optional in nested specs, and if present it must be strictly 1.",
          "type": "integer",
          "const": 1
        },
        "load_csv": {
          "description": "Optional LOAD CSV clause tuple: [url, with_headers, alias]. null means omitted.",
          "type": ["array", "null"],
          "prefixItems": [
            { "type": "string" },
            { "type": "boolean" },
            { "type": "string" }
          ],
          "minItems": 3,
          "items": false
        },
        "unwinds": {
          "description": "List of UNWIND parameter clauses: [[param_name, alias], ...].",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "items": false
          }
        },
        "matches": {
          "description": "Ordered list of graph pattern MATCH / OPTIONAL MATCH clauses.",
          "type": "array",
          "items": { "$ref": "#/$defs/MatchClause" }
        },
        "mutations": {
          "description": "List of DML mutating clauses (CREATE, MERGE, SET, DELETE, REMOVE).",
          "type": "array",
          "items": { "$ref": "#/$defs/MutationClause" }
        },
        "with_clauses": {
          "description": "List of intermediate WITH projection clauses.",
          "type": "array",
          "items": { "$ref": "#/$defs/WithClause" }
        },
        "linear_clauses": {
          "description": "Ordered list of LET / FILTER clauses emitted between MATCH and the first WITH.",
          "type": "array",
          "items": { "$ref": "#/$defs/LinearClause" }
        },
        "projections": {
          "description": "List of RETURN projection items. null means omitted (and, like an empty list, produces no RETURN).",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/ProjectionItem" }
        },
        "distinct": {
          "description": "Whether the RETURN projection applies distinct deduplication. null means omitted.",
          "type": ["boolean", "null"]
        },
        "order_by": {
          "description": "List of ORDER BY ordering specifications. null means omitted.",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/OrderByItem" }
        },
        "skip": {
          "description": "Pagination skip / offset count. An integral JSON number such as 0 or 0.0 is accepted. null means omitted. Do not also set offset.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "offset": {
          "description": "Alias for skip. An integral JSON number such as 0 or 0.0 is accepted. null means omitted. Setting both skip and offset is INVALID_SPEC at the second key.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "limit": {
          "description": "Pagination maximum result rows. An integral JSON number such as 3 or 3.0 is accepted. null means omitted.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "execution_mode": {
          "description": "Query plan execution mode. The spelling is exact. null means omitted.",
          "oneOf": [{ "$ref": "#/$defs/ExecutionMode" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "MatchClause": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "spec_version": {
          "description": "Optional nested spec version; if present it must be 1.",
          "type": "integer",
          "const": 1
        },
        "optional": {
          "description": "Whether this is an OPTIONAL MATCH. null means omitted (false).",
          "type": ["boolean", "null"]
        },
        "path_mode": {
          "description": "Path search mode. The spelling is exact. null means omitted.",
          "oneOf": [{ "$ref": "#/$defs/PathMode" }, { "type": "null" }]
        },
        "path_variable": {
          "description": "Optional path variable name. null means omitted.",
          "type": ["string", "null"]
        },
        "paths": {
          "description": "Non-empty list of traversal paths (the consumer rejects an empty list).",
          "type": "array",
          "items": { "$ref": "#/$defs/Path" }
        },
        "where": {
          "description": "One predicate expression, a list of predicate expressions, or null (omitted). An empty list emits no predicate.",
          "$ref": "#/$defs/WherePredicate"
        }
      },
      "additionalProperties": false
    },
    "WithClause": {
      "type": "object",
      "required": ["projections"],
      "properties": {
        "spec_version": {
          "description": "Optional nested spec version; if present it must be 1.",
          "type": "integer",
          "const": 1
        },
        "distinct": {
          "description": "Whether this WITH applies distinct deduplication. null means omitted.",
          "type": ["boolean", "null"]
        },
        "projections": {
          "description": "Non-empty list of WITH projection items (the consumer rejects an empty list).",
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectionItem" }
        },
        "where": {
          "description": "One predicate expression, a list of predicate expressions, or null (omitted).",
          "$ref": "#/$defs/WherePredicate"
        },
        "order_by": {
          "description": "List of ORDER BY ordering specifications. null means omitted.",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/OrderByItem" }
        },
        "skip": {
          "description": "Pagination skip / offset count. An integral JSON number is accepted. null means omitted.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "limit": {
          "description": "Pagination maximum result rows. An integral JSON number is accepted. null means omitted.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "WherePredicate": {
      "oneOf": [
        { "$ref": "#/$defs/Expression" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/Expression" }
        },
        { "type": "null" }
      ]
    },
    "LinearClause": {
      "oneOf": [
        {
          "description": "LET: ['let', variable, expression]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "let" },
            { "type": "string" },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "FILTER: ['filter', predicate]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "filter" },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 2,
          "items": false
        }
      ]
    },
    "Path": {
      "description": "A traversal path: a list of node and edge steps.",
      "type": "array",
      "items": { "$ref": "#/$defs/PathStep" }
    },
    "PathStep": {
      "description": "A node or relationship step in a graph traversal path. Trailing items beyond the documented shape are accepted only when they are null.",
      "oneOf": [
        { "$ref": "#/$defs/NodeStep" },
        { "$ref": "#/$defs/EdgeStep" }
      ]
    },
    "NodeStep": {
      "description": "Node pattern: ['node', variable | null, labels: string[], properties | null].",
      "type": "array",
      "prefixItems": [
        { "type": "string", "const": "node" },
        { "type": ["string", "null"] },
        { "type": "array", "items": { "type": "string" } },
        { "$ref": "#/$defs/PropertyMap" }
      ],
      "minItems": 3,
      "items": { "type": "null" }
    },
    "EdgeStep": {
      "description": "Edge pattern: ['edge', direction, types: string[], variable | null, min_hops | null, max_hops | null, properties | null]. max_hops null means exactly min_hops.",
      "type": "array",
      "prefixItems": [
        { "type": "string", "const": "edge" },
        { "$ref": "#/$defs/EdgeDirection" },
        { "type": "array", "items": { "type": "string" } },
        { "type": ["string", "null"] },
        { "type": ["integer", "null"], "minimum": 0 },
        { "type": ["integer", "null"], "minimum": 0 },
        { "$ref": "#/$defs/PropertyMap" }
      ],
      "minItems": 3,
      "items": { "type": "null" }
    },
    "PropertyMap": {
      "description": "Optional node or edge property map whose values are tagged expressions. Omitted, null and {} all mean no properties.",
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/Expression" }
    },
    "ProjectionItem": {
      "description": "A projected column or expression in WITH / RETURN clauses.",
      "oneOf": [
        {
          "description": "Direct property access: ['field', variable, property, alias | null]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "field" },
            { "type": "string" },
            { "type": "string" },
            { "type": ["string", "null"] }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "Arbitrary expression: ['expr', expression_spec, alias | null]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "expr" },
            { "$ref": "#/$defs/Expression" },
            { "type": ["string", "null"] }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "Aggregate function: ['agg', variable, property, func, alias | null]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "agg" },
            { "type": "string" },
            { "type": "string" },
            { "$ref": "#/$defs/AggregationFunction" },
            { "type": ["string", "null"] }
          ],
          "minItems": 5,
          "items": false
        }
      ]
    },
    "AggregationFunction": {
      "description": "Aggregation function name. The spelling is exact.",
      "type": "string",
      "enum": ["count", "count_distinct", "sum", "avg", "min", "max", "collect"]
    },
    "OrderByItem": {
      "description": "Ordering specification: [variable, property, direction] or [expression_spec, direction]. direction is true (ascending), false (descending), or the string \"ASC\" / \"DESC\".",
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "type": "string" },
            { "type": "string" },
            { "$ref": "#/$defs/OrderDirection" }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/Expression" },
            { "$ref": "#/$defs/OrderDirection" }
          ],
          "minItems": 2,
          "items": false
        }
      ]
    },
    "OrderDirection": {
      "description": "Ordering direction: true / \"ASC\" for ascending, false / \"DESC\" for descending. The string spellings are uppercase only.",
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "enum": ["ASC", "DESC"] }
      ]
    },
    "MutationClause": {
      "description": "DML graph mutation command.",
      "oneOf": [
        {
          "description": "CREATE mutation: ['create', paths_list]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "create" },
            { "type": "array", "items": { "$ref": "#/$defs/Path" } }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "MERGE mutation: ['merge', path_steps, on_create_sets, on_match_sets]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "merge" },
            { "$ref": "#/$defs/Path" },
            { "type": "array", "items": { "$ref": "#/$defs/MergeSetEntry" } },
            { "type": "array", "items": { "$ref": "#/$defs/MergeSetEntry" } }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "SET property: ['set', variable, property, value_expression]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "set" },
            { "type": "string" },
            { "type": "string" },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "DELETE entities: ['delete', detach: boolean, targets: string[]]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "delete" },
            { "type": "boolean" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "REMOVE property: ['remove', variable, property]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "remove" },
            { "type": "string" },
            { "type": "string" }
          ],
          "minItems": 3,
          "items": false
        }
      ]
    },
    "MergeSetEntry": {
      "description": "ON CREATE SET / ON MATCH SET assignment: [variable, property, value_expression].",
      "type": "array",
      "prefixItems": [
        { "type": "string" },
        { "type": "string" },
        { "$ref": "#/$defs/Expression" }
      ],
      "minItems": 3,
      "items": false
    },
    "Expression": {
      "description": "AST expression node descriptor recognized by the native FFI engine. An arbitrary JSON array is never an expression: every array must start with a known tag. An 'agg' item is not an expression; aggregations are only accepted as projection items in root projections and with_clauses projections.",
      "oneOf": [
        {
          "description": "Property access: ['prop', variable, property]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "prop" },
            { "type": "string", "minLength": 1 },
            { "type": "string" }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "Identifier: ['ident', name]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "ident" },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "Parameter reference: ['param', name]. One leading $ is stripped by the consumer.",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "param" },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "Literal scalar, list or object: ['lit', value]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "lit" },
            { "$ref": "#/$defs/JsonValue" }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "Binary expression: ['bin', operator, left, right]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "bin" },
            { "$ref": "#/$defs/BinaryOperator" },
            { "$ref": "#/$defs/Expression" },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "Unary expression: ['unary', operator, operand]. Unary minus is ['unary', '-', operand].",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "unary" },
            { "$ref": "#/$defs/UnaryOperator" },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "Function call: ['fn', name, args: Expression[]]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "fn" },
            { "type": "string" },
            { "type": "array", "items": { "$ref": "#/$defs/Expression" } }
          ],
          "minItems": 3,
          "items": false
        },
        {
          "description": "CASE expression: ['case', operand | null, branches, else_branch | null]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "case" },
            { "oneOf": [{ "$ref": "#/$defs/Expression" }, { "type": "null" }] },
            { "type": "array", "items": { "$ref": "#/$defs/CaseBranch" } },
            { "oneOf": [{ "$ref": "#/$defs/Expression" }, { "type": "null" }] }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "List comprehension: ['list_comp', variable, list_expr, where_filter | null, map_expr | null]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "list_comp" },
            { "type": "string" },
            { "$ref": "#/$defs/Expression" },
            { "oneOf": [{ "$ref": "#/$defs/Expression" }, { "type": "null" }] },
            { "oneOf": [{ "$ref": "#/$defs/Expression" }, { "type": "null" }] }
          ],
          "minItems": 5,
          "items": false
        },
        {
          "description": "Pattern comprehension: ['pattern_comp', path_spec, where_filter | null, proj_expr]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "pattern_comp" },
            { "$ref": "#/$defs/Path" },
            { "oneOf": [{ "$ref": "#/$defs/Expression" }, { "type": "null" }] },
            { "$ref": "#/$defs/Expression" }
          ],
          "minItems": 4,
          "items": false
        },
        {
          "description": "Existential subquery: ['exists', subquery_spec]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "exists" },
            { "$ref": "#/$defs/SubqueryPayload" }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "Scalar subquery: ['count', subquery_spec]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "count" },
            { "$ref": "#/$defs/SubqueryPayload" }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "List literal: ['list', items: Expression[]]",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "list" },
            { "type": "array", "items": { "$ref": "#/$defs/Expression" } }
          ],
          "minItems": 2,
          "items": false
        },
        {
          "description": "Aliased expression: ['alias', inner_expression, alias_string]. The alias is only meaningful in a projection; elsewhere the consumer validates the name and uses the inner expression.",
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "alias" },
            { "$ref": "#/$defs/Expression" },
            { "type": "string" }
          ],
          "minItems": 3,
          "items": false
        },
        { "$ref": "#/$defs/ObjectWrappedExpression" }
      ]
    },
    "ObjectWrappedExpression": {
      "description": "Object-wrapped expression: { spec_version?: 1, expr: Expression }. spec_version is optional here because it is required only at the document root.",
      "type": "object",
      "properties": {
        "spec_version": { "type": "integer", "const": 1 },
        "expr": { "$ref": "#/$defs/Expression" }
      },
      "required": ["expr"],
      "additionalProperties": false
    },
    "SubqueryPayload": {
      "description": "Payload of an exists/count subquery: a nested query spec object or a path step list.",
      "oneOf": [
        { "$ref": "#/$defs/QuerySpec" },
        { "$ref": "#/$defs/Path" }
      ]
    },
    "CaseBranch": {
      "description": "One CASE WHEN branch: [when, then].",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/Expression" },
        { "$ref": "#/$defs/Expression" }
      ],
      "minItems": 2,
      "items": false
    },
    "JsonValue": {
      "description": "Any JSON value, used by the ['lit', value] payload.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/JsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/JsonValue" }
        }
      ]
    },
    "PathMode": {
      "description": "Path search mode. The spelling is exact (lowercase).",
      "type": "string",
      "enum": ["trail", "simple", "acyclic", "walk", "none"]
    },
    "ExecutionMode": {
      "description": "Query plan execution mode. The spelling is exact.",
      "type": "string",
      "enum": ["normal", "explain", "profile", "explain_and_profile"]
    },
    "EdgeDirection": {
      "description": "Edge direction. The spelling is exact: 'outgoing' ('out', '->'), 'incoming' ('in', '<-'), or 'undirected' ('both', '-', '--').",
      "type": "string",
      "enum": [
        "outgoing",
        "incoming",
        "undirected",
        "out",
        "in",
        "->",
        "<-",
        "-",
        "--",
        "both"
      ]
    },
    "BinaryOperator": {
      "description": "Binary operator. The consumer matches operator names case-insensitively; the canonical spellings are lowercase.",
      "type": "string",
      "enum": [
        "eq",
        "=",
        "neq",
        "ne",
        "!=",
        "<>",
        "lt",
        "<",
        "lte",
        "le",
        "<=",
        "gt",
        ">",
        "gte",
        "ge",
        ">=",
        "in",
        "not_in",
        "not in",
        "contains",
        "starts_with",
        "startswith",
        "ends_with",
        "endswith",
        "regex",
        "=~",
        "and",
        "&",
        "or",
        "|",
        "xor",
        "^",
        "add",
        "+",
        "sub",
        "-",
        "mul",
        "*",
        "div",
        "/",
        "mod",
        "%",
        "concat",
        "||",
        "EQ",
        "NEQ",
        "NE",
        "LT",
        "LTE",
        "LE",
        "GT",
        "GTE",
        "GE",
        "IN",
        "NOT_IN",
        "NOT IN",
        "CONTAINS",
        "STARTS_WITH",
        "STARTSWITH",
        "ENDS_WITH",
        "ENDSWITH",
        "REGEX",
        "AND",
        "OR",
        "XOR",
        "ADD",
        "SUB",
        "MUL",
        "DIV",
        "MOD",
        "CONCAT"
      ]
    },
    "UnaryOperator": {
      "description": "Unary operator. The consumer matches operator names case-insensitively; unary minus is the '-' spelling.",
      "type": "string",
      "enum": [
        "not",
        "~",
        "-",
        "neg",
        "is_null",
        "is null",
        "is_not_null",
        "is not null",
        "NOT",
        "IS_NULL",
        "IS NULL",
        "IS_NOT_NULL",
        "IS NOT NULL"
      ]
    }
  }
}
